#!/bin/sh
# コミットの前に自動で確かめる（2026-10-14）。有効にするには一度だけ: git config core.hooksPath .githooks
# 毎回 npm run check（画像の照合＋テスト＋行のずれの検査。約25秒）を実行する（2026-10-15〜）。
# 以前は public/cards の更新日時で照合を省いていたが、ビット化けは更新日時が変わらない（2026-10-15 の S10a-014 はコミットの後に見つかった）ので、更新日時に頼らない。
# 急いで飛ばすとき（勧めない）: git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1

echo "pre-commit: npm run check（画像の照合・テスト・行のずれの検査）"
npm run check || { echo "pre-commit: 確認に失敗したのでコミットを止めました（画像の照合で「中身が変わった」が出たら、元の出どころから取り直して戻す）"; exit 1; }
touch .git/ptcg-last-image-verify
